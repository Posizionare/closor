# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growthcrm?schema=public"

# NextAuth
AUTH_SECRET="change-me-with-openssl-rand-hex-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# App
APP_NAME="Closor"

# OAuth Google (Calendar / Meet / Ads)
# 1. Vá em https://console.cloud.google.com/apis/credentials
# 2. Crie um OAuth Client ID do tipo "Web application"
# 3. Em "Authorized redirect URIs" adicione: http://localhost:3000/api/oauth/google/callback
# 4. Habilite as APIs: Google Calendar API, Google Ads API (se for usar)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Uploads (placeholder for S3, R2, etc.)
UPLOAD_PROVIDER="local"
UPLOAD_LOCAL_DIR="./public/uploads"

# WhatsApp / Integrações (preenchidas em etapas posteriores)
